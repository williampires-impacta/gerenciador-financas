datasource db {
    provider = "sqlite"
    url      = "file:./dev.db"
}

generator client {
    provider = "prisma-client-js"
}

model User {
    id              String     @id @default(uuid())
    name            String     
    email           String     @unique
    password        String     
    transactions    Transaction[]
    createAt        DateTime    @default(now())
}

model Transaction {
    id             String       @id @default(uuid())
    description    String       
    amount         Float
    type           String       //"RECEITA" (Entrada) ou "DESPESA" (Saída)
    category       String
    DateTime       DateTime     @default(now())
    userId         String
    user           User         @relation(fields: [userId], references: [id])
}